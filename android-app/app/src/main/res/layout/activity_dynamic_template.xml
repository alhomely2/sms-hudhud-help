<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/template_path_intro"
            android:textAppearance="@style/TextAppearance.Hudhud.Subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/choose_file" />

        <TextView
            android:id="@+id/selectedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/no_file_selected"
            android:textAppearance="@style/TextAppearance.Hudhud.CardBody" />

        <TextView
            android:id="@+id/savedTemplatesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/template_campaign_matching_templates"
            android:textAppearance="@style/TextAppearance.Hudhud.CardTitle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyTemplatesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/template_empty_state"
            android:textAppearance="@style/TextAppearance.Hudhud.CardBody"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/templatesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/selectedTemplateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_template_selected"
            android:padding="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.Hudhud.CardBody"
            android:visibility="gone" />

        <TextView
            android:id="@+id/documentProfileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Hudhud.Caption"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewCampaignButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:enabled="false"
            android:text="@string/template_campaign_preview" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addTemplateCampaignButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/template_campaign_add" />

        <TextView
            android:id="@+id/dynamicPreviewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Hudhud.CardBody"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dynamicPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/previewPagination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousPreviewPageButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_campaign_previous_page" />

            <TextView
                android:id="@+id/previewPageText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Hudhud.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextPreviewPageButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_campaign_next_page" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/template_file_help"
            android:textAppearance="@style/TextAppearance.Hudhud.Caption" />
    </LinearLayout>
</ScrollView>
