<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hudhud_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <!-- Header with Steps Indicator -->
        <TextView
            android:id="@+id/editorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_template_path"
            android:textAppearance="@style/TextAppearance.Hudhud.Display" />

        <!-- Steps Indicator -->
        <LinearLayout
            android:id="@+id/stepsIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/step1Indicator"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_step_active" />

            <View
                android:layout_width="@dimen/space_sm"
                android:layout_height="1dp" />

            <View
                android:id="@+id/step2Indicator"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_step_inactive" />

            <View
                android:layout_width="@dimen/space_sm"
                android:layout_height="1dp" />

            <View
                android:id="@+id/step3Indicator"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_step_inactive" />

        </LinearLayout>

        <!-- Step Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step1Label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/step1_basic_info"
                android:textAppearance="@style/TextAppearance.Hudhud.Caption"
                android:textColor="@color/hudhud_primary" />

            <View
                android:layout_width="@dimen/space_sm"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/step2Label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/step2_select_data"
                android:textAppearance="@style/TextAppearance.Hudhud.Caption"
                android:textColor="@color/hudhud_on_surface_muted" />

            <View
                android:layout_width="@dimen/space_sm"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/step3Label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/step3_preview"
                android:textAppearance="@style/TextAppearance.Hudhud.Caption"
                android:textColor="@color/hudhud_on_surface_muted" />

        </LinearLayout>

        <!-- Step 1: Basic Info -->
        <LinearLayout
            android:id="@+id/step1Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Template Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/template_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/templateNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Message Body -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hudhud.Card.Static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:cardBackgroundColor="@color/hudhud_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/template_message_body"
                        android:textAppearance="@style/TextAppearance.Hudhud.CardTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/bodyLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        app:counterEnabled="true"
                        app:counterMaxLength="1000"
                        app:helperText="@string/template_body_helper">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/templateBodyInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="1000"
                            android:minLines="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Select Document Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectDocumentButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/select_document"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_document"
                app:iconGravity="textStart" />

            <!-- Selected Document Info -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectedDocumentCard"
                style="@style/Widget.Hudhud.Card.Static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/hudhud_surface"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_document"
                        android:contentDescription="@string/document"
                        app:tint="@color/hudhud_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/selectedFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Hudhud.CardTitle"
                            tools:text="clients.xlsx" />

                        <TextView
                            android:id="@+id/selectedFileInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Hudhud.Caption"
                            tools:text="5 أعمدة × 100 صف" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/changeDocumentButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/change_document"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/hudhud_on_surface_muted" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextToStep2Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_lg"
                android:enabled="false"
                android:text="@string/next_step"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <!-- Step 2: Select Data -->
        <LinearLayout
            android:id="@+id/step2Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Document Data Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/document_columns"
                android:textAppearance="@style/TextAppearance.Hudhud.CardTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/select_columns_to_include"
                android:textAppearance="@style/TextAppearance.Hudhud.Caption" />

            <!-- Data Fields RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dataFieldsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_template_field" />

            <!-- Fixed Data Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hudhud.Card.Static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:cardBackgroundColor="@color/hudhud_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fixed_data_section"
                        android:textAppearance="@style/TextAppearance.Hudhud.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/fixed_data_help"
                        android:textAppearance="@style/TextAppearance.Hudhud.Caption" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fixedDataRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_template_fixed_field" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addFixedDataButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/add_fixed_field"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backToStep1Button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/previous_step"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextToStep3Button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/next_step"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Step 3: Preview & Save -->
        <LinearLayout
            android:id="@+id/step3Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Preview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hudhud.Card.Static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/hudhud_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/template_preview"
                        android:textAppearance="@style/TextAppearance.Hudhud.CardTitle" />

                    <TextView
                        android:id="@+id/previewTemplateName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.Hudhud.Body"
                        android:textStyle="bold"
                        tools:text="قالب عملاء VIP" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_sm"
                        android:background="@color/hudhud_divider" />

                    <TextView
                        android:id="@+id/previewMessageBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_message_preview"
                        android:padding="@dimen/space_md"
                        android:textAppearance="@style/TextAppearance.Hudhud.Body"
                        tools:text="مرحباً {{اسم_العميل}}، نهنئكم بمناسبة {{الحدث}} ونتمنى لكم {{التمنى}}." />

                    <!-- Selected Fields Summary -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/selected_fields"
                        android:textAppearance="@style/TextAppearance.Hudhud.SectionLabel" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/selectedFieldsChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />

                    <!-- Fixed Values Summary -->
                    <TextView
                        android:id="@+id/fixedValuesLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/fixed_values"
                        android:textAppearance="@style/TextAppearance.Hudhud.SectionLabel"
                        android:visibility="gone" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/fixedValuesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backToStep2Button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/previous_step"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveTemplateButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/save_template"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Loading Indicator -->
        <FrameLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/processing_document"
                    android:textAppearance="@style/TextAppearance.Hudhud.Caption" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</ScrollView>