<?xml version="1.0" encoding="utf-8"?>
<!--
    Persistent bottom navigation: four destinations plus a raised send action.
    Child order defines the RTL order, so the first item appears on the right:
    الرئيسية / الحملات / إرسال / القوالب / الإعدادات.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_bar_container_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_bar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/nav_home"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="@dimen/size_icon"
                android:layout_height="@dimen/size_icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/hudhud_on_surface_muted" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_home"
                android:textAppearance="@style/TextAppearance.Hudhud.NavLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCampaigns"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/nav_campaigns"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navCampaignsIcon"
                android:layout_width="@dimen/size_icon"
                android:layout_height="@dimen/size_icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_campaigns"
                app:tint="@color/hudhud_on_surface_muted" />

            <TextView
                android:id="@+id/navCampaignsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_campaigns"
                android:textAppearance="@style/TextAppearance.Hudhud.NavLabel" />
        </LinearLayout>

        <!-- Empty slot that keeps the bar symmetric under the raised send action. -->
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/navTemplates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/nav_templates"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navTemplatesIcon"
                android:layout_width="@dimen/size_icon"
                android:layout_height="@dimen/size_icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_templates"
                app:tint="@color/hudhud_on_surface_muted" />

            <TextView
                android:id="@+id/navTemplatesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_templates"
                android:textAppearance="@style/TextAppearance.Hudhud.NavLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/nav_settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="@dimen/size_icon"
                android:layout_height="@dimen/size_icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                app:tint="@color/hudhud_on_surface_muted" />

            <TextView
                android:id="@+id/navSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_settings"
                android:textAppearance="@style/TextAppearance.Hudhud.NavLabel" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ring in the screen color so the raised button reads as cut into the bar. -->
    <View
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_nav_send_halo" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navSend"
        android:layout_width="@dimen/nav_send_size"
        android:layout_height="@dimen/nav_send_size"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:contentDescription="@string/nav_send"
        android:focusable="true"
        app:cardBackgroundColor="@color/hudhud_primary"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:rippleColor="@color/hudhud_ripple"
        app:strokeColor="@color/hudhud_primary_variant"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_send"
            app:tint="@color/hudhud_on_primary" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
