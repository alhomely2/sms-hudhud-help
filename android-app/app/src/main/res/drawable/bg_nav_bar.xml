<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hudhud_surface" />
        </shape>
    </item>
    <!-- Hairline that separates the bar from the scrolling content. -->
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/hudhud_outline" />
        </shape>
    </item>
</layer-list>
